[Unit]
Description=HQ SQLite Backup
After=hq.service

[Service]
Type=oneshot
# Must match hq.service, or backups become root-owned and the app user can
# neither prune nor restore them.
User=rehan
Group=rehan
WorkingDirectory=/home/rehan/Apps/hq
# Must match hq.service. The script backs up the paths HQ_DEEN_DATABASE and
# HQ_DATABASE point at, so without the same environment it would snapshot the
# defaults while the live databases went untouched — and still report success.
EnvironmentFile=-/home/rehan/Apps/hq/.env
# VACUUM INTO reads through a live WAL, so the app keeps serving during this.
ExecStart=/usr/bin/node /home/rehan/Apps/hq/scripts/backup.mjs
